# Optional: defaults to <repo_root>/.lite-rag when unset
LITE_RAG_STORAGE_ROOT=/absolute/path/to/local-lite-rag-data
LITE_RAG_EMBED_MODEL=BAAI/bge-m3
LITE_RAG_EMBED_PROVIDER=local
# LITE_RAG_EMBED_API_URL=http://127.0.0.1:9000/v1/embeddings
# LITE_RAG_EMBED_API_KEY=
LITE_RAG_EMBED_BATCH_SIZE=32
LITE_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LITE_RAG_RERANK_PROVIDER=local
# LITE_RAG_RERANK_API_URL=http://127.0.0.1:9000/v1/rerank
# LITE_RAG_RERANK_API_KEY=
LITE_RAG_MODEL_API_TIMEOUT=30
LITE_RAG_ENABLE_RERANKER=false
LITE_RAG_DEFAULT_MODE=hybrid
LITE_RAG_CHUNK_SIZE=800
LITE_RAG_CHUNK_OVERLAP=120
