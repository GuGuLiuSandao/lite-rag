# CLI/API read <repo_root>/.env; existing environment variables take precedence.
# Unset storage root defaults to <repo_root>/.lite-rag.
# LITE_RAG_STORAGE_ROOT=/absolute/path/to/local-lite-rag-data

# Each provider can be local or http, independently.
LITE_RAG_EMBED_PROVIDER=local
LITE_RAG_EMBED_MODEL=BAAI/bge-m3
# LITE_RAG_EMBED_API_URL=http://127.0.0.1:9000/v1/embeddings
# LITE_RAG_EMBED_API_KEY=
LITE_RAG_EMBED_BATCH_SIZE=32

LITE_RAG_ENABLE_RERANKER=true
LITE_RAG_RERANK_PROVIDER=local
LITE_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# LITE_RAG_RERANK_API_URL=http://127.0.0.1:9000/v1/rerank
# LITE_RAG_RERANK_API_KEY=
LITE_RAG_MODEL_API_TIMEOUT=30

LITE_RAG_DEFAULT_MODE=hybrid
LITE_RAG_CHUNK_SIZE=800
LITE_RAG_CHUNK_OVERLAP=120

# Docker Compose (host paths; container storage is always /data).
# LITE_RAG_DATA_DIR=./.lite-rag
# LITE_RAG_WEB_PORT=8080
# Set false for an HTTP-only image; also configure HTTP providers above.
# LITE_RAG_INSTALL_LOCAL_MODELS=true
# Optional host Hugging Face cache, reused instead of a Docker named volume.
# LITE_RAG_MODEL_CACHE=/absolute/path/to/.cache/huggingface
# Bound CPU inference parallelism to avoid oversubscription on local deployments.
# LITE_RAG_CPU_THREADS=4
